{
  "name": "muster",
  "private": true,
  "version": "0.21.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vue-tsc --noEmit && vite build && node scripts/build-third-party-notices.mjs",
    "build:app": "node scripts/build-app.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "tauri dev --features dev-bridge --config src-tauri/tauri.dev-bridge.conf.json",
    "release": "bash scripts/release.sh",
    "release:check": "node scripts/release.mjs --check",
    "release:preview": "node scripts/release.mjs --bump --dry-run",
    "release:validate": "pnpm release:check && pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm lint:rust && pnpm test",
    "fmt": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{json,js,ts,html}\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{json,js,ts,html}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "eslint src vite.config.ts",
    "lint:rust": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "typecheck": "vue-tsc --noEmit",
    "test:frontend": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run -t SEC- && cargo test --locked --manifest-path src-tauri/Cargo.toml sec_",
    "test:audit": "node --test scripts/audit-rust.test.mjs",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml && if [ \"$(uname -s)\" = Linux ]; then CARGO_TARGET_DIR=src-tauri/target cargo test --release --locked --manifest-path src-tauri/vendor/glib-0.18.5/Cargo.toml test_variant_str_iter; fi",
    "test:release": "node --test scripts/release.test.mjs scripts/release-artifacts.test.mjs",
    "test:artifacts": "pnpm build && node --test scripts/artifacts.test.mjs scripts/build-third-party-notices.test.mjs scripts/build-app.test.mjs scripts/xterm-debug-log-plugin.test.mjs",
    "test": "pnpm test:frontend && pnpm test:release && pnpm test:audit && pnpm test:rust && pnpm test:artifacts",
    "audit:js": "pnpm audit --audit-level moderate",
    "audit:rust": "node scripts/audit-rust.mjs",
    "audit:security": "pnpm audit:js && pnpm audit:rust"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@git-diff-view/vue": "^0.1.7",
    "@lezer/highlight": "^1.2.4",
    "@lucide/vue": "^1.48.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "picomatch": "^4.0.7",
    "prettier": "^3.6.2",
    "reka-ui": "^2.5.0",
    "shiki": "^4.4.3",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.12.0",
    "@types/markdown-it": "^14.2.0",
    "@types/picomatch": "^4.0.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "^2.5.1",
    "@xterm/headless": "^6.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "happy-dom": "^20.14.5",
    "svgo": "^3.3.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.8"
  }
}

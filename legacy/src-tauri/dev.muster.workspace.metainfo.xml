<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata, installed by the .deb at /usr/share/metainfo so the app shows up with its
  name, summary and icon in GNOME Software, KDE Discover and the like.
  The component ID must match the `identifier` in tauri.conf.json.
-->
<component type="desktop-application">
  <id>dev.muster.workspace</id>
  <name>Muster</name>
  <summary>A focused workspace for repositories and checkouts</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      Muster keeps a repository and its checkouts in one window: browse files, review diffs, leave
      notes, and keep a terminal per checkout.
    </p>
  </description>
  <launchable type="desktop-id">Muster.desktop</launchable>
  <url type="homepage">https://github.com/MaraniMatias/Muster</url>
  <provides>
    <binary>muster</binary>
  </provides>
  <categories>
    <category>Development</category>
  </categories>
</component>
